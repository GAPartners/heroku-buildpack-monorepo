#!/usr/bin/env bash

# Ensure wildcards in globs match dotfiles too.
shopt -s dotglob

indent() {
    sed -u 's/^/      /'
}

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="$3"
STAGE="$(mktemp -d)"

if [ ! -f "${ENV_DIR}/APP_BASE" ]; then
    echo "APP_BASE was not set. Aborting" | indent
    exit 1
fi
APP_BASE="$(cat "${ENV_DIR}/APP_BASE")"

# APP_EXTRA (optional): directories outside APP_BASE that the app needs at build
# time, comma- or space-separated and relative to the repo root - for example
# `gems`, so a Gemfile `path:` gem living beside the app survives the hoist.
#
# Each one is moved INTO the staged app at the same relative path, so after the
# hoist it sits at `<build root>/<extra>`. The app can therefore refer to it by a
# path that resolves both in a checkout and after the hoist by committing a symlink
# at `<APP_BASE>/<extra>` pointing back up to the real directory: in a checkout the
# symlink resolves, here the symlink is replaced by the directory itself.
APP_EXTRA=""
if [ -f "${ENV_DIR}/APP_EXTRA" ]; then
    APP_EXTRA="$(tr ',' ' ' < "${ENV_DIR}/APP_EXTRA")"
fi

STAGED_APP="${STAGE}/$(basename "$APP_BASE")"

(
    set -e
    mv "${BUILD_DIR}/${APP_BASE}" "${STAGE}"
    for extra in ${APP_EXTRA}; do
        extra="${extra#/}"; extra="${extra%/}"
        # Not an error: the config is meant to be set on the app BEFORE the
        # directory exists in the branch it deploys, so the two can be sequenced
        # independently. A typo shows up as "skipped" here and as a missing path
        # gem at bundle install, which names the directory.
        if [ ! -d "${BUILD_DIR}/${extra}" ]; then
            echo "APP_EXTRA names ${extra}, which is not a directory in this checkout - skipped" | indent
            continue
        fi
        # A committed symlink at the same path is the checkout-side half of the
        # trick; drop it so the real directory can take its place.
        rm -rf "${STAGED_APP:?}/${extra}"
        mkdir -p "$(dirname "${STAGED_APP}/${extra}")"
        mv "${BUILD_DIR}/${extra}" "${STAGED_APP}/${extra}"
        echo "Staged ${extra} into ${APP_BASE}/${extra}" | indent
    done
    rm -rf "${BUILD_DIR:?}"/*
    mv "${STAGED_APP}"/* "${BUILD_DIR}"
)

if [ $? -ne 0 ]; then
    echo "FAILED to copy directory into place" | indent
    exit 1
fi

echo "Copied ${APP_BASE} to root of app successfully" | indent
